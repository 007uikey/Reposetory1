pipeline {

    agent {
        label 'slave1'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy Master') {

            steps {

                git branch:'master',
                url:'https://github.com/username/repo.git'


                sh '''
                pwd
                ls -la

                docker rm -f c1 || true

                docker run -dit \
                --name c1 \
                -p 80:80 \
                httpd

                docker cp index.html \
                c1:/usr/local/apache2/htdocs/index.html

                docker exec c1 chmod 644 \
                /usr/local/apache2/htdocs/index.html

                '''
            }
        }

        stage('Deploy Q1 to c2') {

            steps {

                dir('q1-code') {

                    git branch:'Q1',
                    url:'https://github.com/username/repo.git'

                    sh '''

                    docker rm -f c2 || true

                    docker run -dit \
                    --name c2 \
                    -p 90:80 \
                    httpd

                    docker cp index.html \
                    c2:/usr/local/apache2/htdocs/index.html

                    '''
                }
            }
        }

        stage('Deploy Q2 to c3') {

            steps {

                dir('q2-code') {

                    git branch:'Q2',
                    url:'https://github.com/username/repo.git'

                    sh '''

                    docker rm -f c3 || true

                    docker run -dit \
                    --name c3 \
                    -p 8081:80 \
                    httpd

                    docker cp index.html \
                    c3:/usr/local/apache2/htdocs/index.html

                    '''
                }
            }
        }

    }
}
