pipeline {

    agent any

    stages {

        stage('clone repo1') {

            steps {
                git branch: 'master',
                url: 'https://github.com/007uikey/Reposetory1.git'

            }
        }

        stage('Delete old websites') {

            steps {

                sh 'rm -rf /var/www/html/*'

            }
        }

        stage('Deploy repo1 and set permission') {

            steps {

                sh 'sudo cp -r * /var/www/html/'
                sh 'sudo chmod -R 777 /var/www/html'
            }
        }
    }
}
