pipeline {
    agent any

    stages {

        stage('Clean Old Deployment') {
            steps {
                sh 'sudo rm -rf /var/www/html/*'
            }
        }

        stage('Deploy New Files') {
            steps {
                sh 'sudo cp -r * /var/www/html/'
                sh 'sudo chown -R apache:apache /var/www/html'
            }
        }

    }

    post {
        success {
            echo 'Repo1 deployed successfully'
        }
    }
}
